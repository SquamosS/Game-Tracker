<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); its global usings would clash with WPF names. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the project also compile on non-Windows machines (CI, containers). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>GameTracker</AssemblyName>
    <RootNamespace>GameTracker</RootNamespace>
    <!-- The GP logo: exe, taskbar and tray (assets\app\logo.png is the 512px source picture). -->
    <ApplicationIcon>assets\app\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\app\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="guides\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
