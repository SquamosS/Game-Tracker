<Window x:Class="GameTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Tracker" Width="400" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        FontFamily="Bahnschrift" FontSize="13" Foreground="#E2E8F0">
  <Border Background="#800F172A" BorderBrush="#03FFFFFF" BorderThickness="1" CornerRadius="12">
    <DockPanel Margin="14">
      <!-- A thin dark halo around all text (Outline in QuestWindow.cs), readable over bright scenes. -->
      <DockPanel.Effect>
        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="4" Opacity="1" />
      </DockPanel.Effect>
      <!-- Three levels only: a small chapter label with the count, the live quest, then what is left to get. -->
      <StackPanel DockPanel.Dock="Top" x:Name="Header" Cursor="SizeAll">
        <DockPanel>
          <!-- Language switch EN | IN (also Ctrl+Shift+L, or Ctrl+Shift+Alt+L when taken): the lit side is the language shown. -->
          <Border x:Name="LangSwitch" DockPanel.Dock="Right" Cursor="Hand" Background="#33FFFFFF" CornerRadius="7" Padding="1"
                  Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="English / Bahasa Indonesia">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="LangEn" CornerRadius="6" Padding="5,0,5,1">
                <TextBlock x:Name="LangEnText" Text="EN" FontSize="9.5" FontWeight="Bold" />
              </Border>
              <Border x:Name="LangIn" CornerRadius="6" Padding="5,0,5,1">
                <TextBlock x:Name="LangInText" Text="IN" FontSize="9.5" FontWeight="Bold" />
              </Border>
            </StackPanel>
          </Border>
          <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#94A3B8" FontSize="11.5" Margin="8,0,0,0" />
          <TextBlock x:Name="ChapterText" Foreground="#5EEAD4" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Margin="0,4,0,8" Height="2">
          <Border Background="#33FFFFFF" />
          <Border x:Name="Bar" Background="#5EEAD4" HorizontalAlignment="Left" Width="0" />
        </Grid>
        <!-- Where you are, as the game's map names it: saves opening the map to match the guide's "where". -->
        <TextBlock x:Name="LocationText" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        <!-- The way to the next step's room, through rooms you have walked between before (only when fully known). -->
        <TextBlock x:Name="RouteText" Margin="0,-4,0,8" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" />
        <!-- What the overlay just did on its own (ticked, learned, undone) or missed at a chapter's end; fades after a while. -->
        <Border x:Name="NoticeBox" Background="#264ADE80" BorderBrush="#4ADE80" BorderThickness="3,0,0,0" Padding="8,3" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12.5" Foreground="White" />
        </Border>
        <!-- Open steps in the area you are in: pulses when you walk in, so nothing has to be read to notice it. -->
        <Border x:Name="HereBox" Background="#2614B8A6" BorderBrush="#5EEAD4" BorderThickness="3,0,0,0" Padding="8,4" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock x:Name="HereText" TextWrapping="Wrap" FontSize="13" />
        </Border>
        <TextBlock x:Name="ObjectiveText" TextWrapping="Wrap" />
        <!-- A thin accent, not a red block: amber while the point of no return is ahead, red when it is the step you are on. -->
        <Border x:Name="WarnBox" Cursor="Hand" Background="Transparent" BorderBrush="#FBBF24" BorderThickness="2,0,0,0" Padding="8,1,0,1" Margin="0,8,0,0">
          <TextBlock x:Name="WarnText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#FBBF24" FontSize="12" />
        </Border>
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" x:Name="FooterText" Foreground="#64748B" FontSize="10.5"
                 TextWrapping="Wrap" Margin="0,8,0,0" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel x:Name="List" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
