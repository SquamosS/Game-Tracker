<Window x:Class="GameTracker.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Tracker" Width="960" Height="560" MinWidth="640" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Foreground="#E2E8F0">
  <Border CornerRadius="12" BorderBrush="#22FFFFFF" BorderThickness="1" ClipToBounds="True">
    <Border.Background>
      <SolidColorBrush Color="#0F172A" />
    </Border.Background>
    <Grid>
      <!-- The selected game's picture, darkened on the left where the list sits. -->
      <Border x:Name="Picture" CornerRadius="12" />
      <Border CornerRadius="12">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F20F172A" Offset="0" />
            <GradientStop Color="#D90F172A" Offset="0.42" />
            <GradientStop Color="#330F172A" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <DockPanel Margin="22,14,22,18">
        <!-- Title bar: drag to move. -->
        <DockPanel DockPanel.Dock="Top" x:Name="TitleBar" Background="Transparent" Height="34">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="MinButton" Content="—" Style="{DynamicResource ChromeButton}" />
            <Button x:Name="CloseButton" Content="✕" Style="{DynamicResource ChromeButton}" />
          </StackPanel>
          <TextBlock Text="Game Tracker" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Left" Width="400" Margin="0,14,0,0">
          <!-- Search: filters the list by name as you type. -->
          <Grid Margin="0,0,0,12">
            <TextBox x:Name="Search" Height="34" Padding="34,7,10,0" FontSize="13" Foreground="#E2E8F0"
                     Background="#990F172A" BorderBrush="#33FFFFFF" BorderThickness="1" CaretBrush="#38BDF8" />
            <TextBlock Text="⌕" FontSize="17" Foreground="#64748B" Margin="12,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock x:Name="SearchHint" Text="Cari game..." Foreground="#64748B" Margin="35,0,0,1"
                       VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <StackPanel x:Name="Games" />
          </ScrollViewer>
          <TextBlock x:Name="Empty" Text="Tidak ada game yang cocok." Foreground="#64748B" Margin="4,8,0,0" Visibility="Collapsed" />
        </StackPanel>
        <Grid />
      </DockPanel>
    </Grid>
  </Border>

  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="Background" Value="#22FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
</Window>
